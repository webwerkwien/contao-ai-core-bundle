{
    "name": "webwerkwien/contao-ai-core-bundle",
    "description": "Contao 5 console commands for agent-driven CRUD operations",
    "type": "contao-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Morgenbesser",
            "homepage": "https://web.werk.wien",
            "role": "Developer"
        }
    ],
    "keywords": [
        "contao",
        "ai",
        "agent",
        "crud",
        "cli",
        "automation",
        "console",
        "ssh",
        "contao-ai",
        "ki",
        "ki-agent",
        "redakteur",
        "automatisierung",
        "kommandozeile"
    ],
    "homepage": "https://github.com/webwerkwien/contao-ai-core-bundle",
    "support": {
        "issues": "https://github.com/webwerkwien/contao-ai-core-bundle/issues",
        "source": "https://github.com/webwerkwien/contao-ai-core-bundle"
    },
    "require": {
        "php": "^8.2",
        "contao/core-bundle": "^5.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "symfony/console": "^6.0",
        "contao/calendar-bundle": "^5.3",
        "contao/comments-bundle": "^5.3",
        "contao/faq-bundle": "^5.3",
        "contao/news-bundle": "^5.3",
        "phpstan/phpstan": "^2.1",
        "contao/manager-plugin": "^2.13",
        "contao/newsletter-bundle": "^5.3",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Webwerkwien\\ContaoAiCoreBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webwerkwien\\ContaoAiCoreBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Webwerkwien\\ContaoAiCoreBundle\\ContaoManager\\Plugin"
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpunit": "phpunit",
        "ci": [
            "@phpstan",
            "@phpunit"
        ]
    },
    "config": {
        "allow-plugins": {
            "contao/manager-plugin": true
        }
    }
}
